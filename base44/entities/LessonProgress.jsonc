{
  "name": "LessonProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "specialization_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "video_position": {
      "type": "number",
      "default": 0
    },
    "video_completed": {
      "type": "boolean",
      "default": false
    },
    "activity_completed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "lesson_id"
  ]
}