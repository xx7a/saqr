{
  "name": "SpecializationEnrollment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "specialization_id": {
      "type": "string"
    },
    "specialization_name": {
      "type": "string"
    },
    "enrolled_date": {
      "type": "string",
      "format": "date-time"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "specialization_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}