{
  "name": "CompassQuestion",
  "type": "object",
  "properties": {
    "specialization_id": {
      "type": "string"
    },
    "specialization_name": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "concept",
        "analysis",
        "practical"
      ],
      "default": "concept"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "correct_option_id": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "medium"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "specialization_id",
    "question",
    "correct_option_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}