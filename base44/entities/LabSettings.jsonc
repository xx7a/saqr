{
  "name": "LabSettings",
  "type": "object",
  "properties": {
    "api_base_url": {
      "type": "string",
      "description": "Lab API base URL (e.g. https://labs.saqr5.com)"
    },
    "start_endpoint": {
      "type": "string",
      "default": "/start-lab"
    },
    "status_endpoint_template": {
      "type": "string",
      "default": "/lab/{session_id}"
    },
    "stop_endpoint_template": {
      "type": "string",
      "default": "/lab/{session_id}"
    },
    "timeout_seconds": {
      "type": "number",
      "default": 30
    },
    "status_check_interval_seconds": {
      "type": "number",
      "default": 15,
      "description": "How often the frontend polls the lab status (seconds)"
    },
    "max_concurrent_labs": {
      "type": "number",
      "default": 10
    },
    "max_labs_per_user": {
      "type": "number",
      "default": 1
    },
    "default_lab_duration": {
      "type": "number",
      "default": 45,
      "description": "Default lab duration in minutes"
    },
    "labs_enabled": {
      "type": "boolean",
      "default": true
    },
    "maintenance_mode": {
      "type": "boolean",
      "default": false
    },
    "maintenance_message": {
      "type": "string",
      "default": "\u0646\u0638\u0627\u0645 \u0627\u0644\u0644\u0627\u0628\u0627\u062a \u062a\u062d\u062a \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u062d\u0627\u0644\u064a\u064b\u0627"
    },
    "allow_reset": {
      "type": "boolean",
      "default": true
    },
    "allow_stop": {
      "type": "boolean",
      "default": true
    },
    "show_timer": {
      "type": "boolean",
      "default": true
    },
    "show_target_ip": {
      "type": "boolean",
      "default": true
    },
    "allow_multiple_labs": {
      "type": "boolean",
      "default": false
    },
    "lab_provider": {
      "type": "string",
      "default": "SAQR Lab API"
    },
    "environment_type": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development"
      ],
      "default": "development"
    },
    "desktop_gateway_url": {
      "type": "string",
      "description": "Optional desktop gateway/proxy URL"
    },
    "proxy_settings": {
      "type": "string",
      "description": "Optional proxy/Cloudflare settings notes"
    },
    "last_connection_test": {
      "type": "string",
      "format": "date-time"
    },
    "last_connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "failed",
        "unknown"
      ],
      "default": "unknown"
    },
    "last_connection_response_time": {
      "type": "number",
      "description": "Response time in milliseconds"
    },
    "api_key_configured": {
      "type": "boolean",
      "default": false,
      "description": "Whether LAB_API_KEY secret is set (managed from admin, actual key stays in secrets)"
    }
  },
  "required": [
    "api_base_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}