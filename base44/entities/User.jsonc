{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0627\u0644\u0645\u0646\u0635\u0629 \u2014 \u0645\u062f\u064a\u0631 \u0623\u0648 \u0637\u0627\u0644\u0628 \u0641\u0642\u0637\u060c \u0644\u0627 \u064a\u0642\u0628\u0644 \u0642\u064a\u0645\u064b\u0627 \u0623\u062e\u0631\u0649",
      "enum": [
        "admin",
        "student"
      ],
      "default": "student"
    },
    "avatar_url": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0627\u0645 \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062a\u0635\u062f\u0631\u064a\u0646"
    },
    "hide_public_identity": {
      "type": "boolean",
      "default": false,
      "description": "\u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0639\u0631\u0636 \u0627\u0633\u0645 \u0645\u0633\u062a\u0639\u0627\u0631 \u0648\u0635\u0648\u0631\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629"
    },
    "is_test_account": {
      "type": "boolean",
      "default": false,
      "description": "\u062d\u0633\u0627\u0628 \u062a\u062c\u0631\u064a\u0628\u064a \u0645\u0633\u062a\u062b\u0646\u0649 \u0645\u0646 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629"
    },
    "excluded_from_leaderboard": {
      "type": "boolean",
      "default": false,
      "description": "\u062d\u0630\u0641 \u0646\u0647\u0627\u0626\u064a \u0645\u0646 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062a\u0635\u062f\u0631\u064a\u0646 \u2014 \u0644\u0627 \u064a\u0638\u0647\u0631 \u0645\u0647\u0645\u0627 \u0643\u0627\u0646\u062a \u0646\u0642\u0627\u0637\u0647"
    },
    "lab_points": {
      "type": "number",
      "default": 0,
      "description": "\u0646\u0642\u0627\u0637 \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0644\u0645\u0646\u0627\u0641\u0633\u0629 (\u0645\u0646\u0641\u0635\u0644\u0629 \u0639\u0646 total_points)"
    },
    "education_level": {
      "type": "string",
      "enum": [
        "high_school",
        "university",
        "graduate",
        "professional",
        "other"
      ],
      "description": "\u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062f\u0631\u0627\u0633\u064a\u0629"
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u0628\u0631\u0629",
      "default": "beginner"
    },
    "learning_goal": {
      "type": "string",
      "description": "\u0627\u0644\u0647\u062f\u0641 \u0645\u0646 \u0627\u0644\u062a\u0639\u0644\u0645"
    },
    "city": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u062f\u064a\u0646\u0629"
    },
    "bio": {
      "type": "string",
      "description": "\u0646\u0628\u0630\u0629 \u0642\u0635\u064a\u0631\u0629"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "learning_streak": {
      "type": "number",
      "default": 0
    },
    "weekly_goal_minutes": {
      "type": "number",
      "default": 120
    },
    "is_profile_public": {
      "type": "boolean",
      "default": false
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar",
      "description": "\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}