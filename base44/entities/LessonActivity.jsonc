{
  "name": "LessonActivity",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "\u0646\u0635 \u0627\u0644\u0633\u0624\u0627\u0644 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "question_tag": {
      "type": "string",
      "enum": [
        "\u0641\u0647\u0645",
        "\u062a\u0637\u0628\u064a\u0642",
        "\u062a\u062d\u0644\u064a\u0644"
      ],
      "default": "\u0641\u0647\u0645"
    },
    "scenario": {
      "type": "string",
      "description": "\u0633\u064a\u0627\u0642 \u0623\u0648 \u0645\u0648\u0642\u0641 \u0644\u0644\u0633\u0624\u0627\u0644 (\u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644)"
    },
    "goal": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "scenario_question",
        "order_steps",
        "match_terms",
        "classify_items",
        "choose_decision",
        "drag_drop",
        "find_error",
        "analyze_case",
        "terminal",
        "code_editor",
        "multiple_choice",
        "true_false"
      ],
      "default": "multiple_choice"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "easy"
    },
    "points": {
      "type": "number",
      "default": 10
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "correct_answer": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u0635\u062d\u064a\u062d (id)"
    },
    "hint": {
      "type": "string"
    },
    "explanation": {
      "type": "string",
      "description": "\u062a\u0641\u0633\u064a\u0631 \u0644\u0645\u0627\u0630\u0627 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629"
    },
    "activity_data": {
      "type": "object",
      "additionalProperties": true
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "is_correct": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "lesson_id",
    "title"
  ]
}