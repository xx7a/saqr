{
  "name": "RealLabCompletion",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lab_id": {
      "type": "string"
    },
    "lab_title": {
      "type": "string"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "flag_submitted": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "lab_id",
    "points_awarded"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}