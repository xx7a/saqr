{
  "name": "Submission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "assignment_title": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "link_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "graded"
      ],
      "default": "draft"
    },
    "grade": {
      "type": "number"
    },
    "feedback": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "user_id"
  ]
}