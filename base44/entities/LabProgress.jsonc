{
  "name": "LabProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lab_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "points_earned": {
      "type": "number",
      "default": 0
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "hints_used": {
      "type": "number",
      "default": 0
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "lab_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}