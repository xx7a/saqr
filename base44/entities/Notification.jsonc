{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_subject",
        "new_lesson",
        "assignment_due",
        "assignment_graded",
        "certificate_issued",
        "badge_earned",
        "specialization_launch",
        "announcement"
      ],
      "default": "announcement"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}