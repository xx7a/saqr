{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "specialization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "title_en": {
      "type": "string",
      "description": "English lesson title"
    },
    "slug": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "short_description_en": {
      "type": "string",
      "description": "English short description"
    },
    "content": {
      "type": "string"
    },
    "content_en": {
      "type": "string",
      "description": "English lesson content"
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term_ar": {
            "type": "string"
          },
          "term_en": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "definition_en": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "estimated_minutes": {
      "type": "number",
      "default": 15
    },
    "lesson_type": {
      "type": "string",
      "enum": [
        "theory",
        "tool",
        "network",
        "os",
        "programming",
        "security",
        "lab"
      ],
      "default": "theory"
    },
    "video_url": {
      "type": "string"
    },
    "video_url_en": {
      "type": "string",
      "description": "English video URL if available"
    },
    "video_duration": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "has_activity": {
      "type": "boolean",
      "default": true
    },
    "has_lab": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "subject_id",
    "title"
  ]
}