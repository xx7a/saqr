{
  "name": "RealLabSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lab_id": {
      "type": "string"
    },
    "lab_title": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0639\u0627\u0626\u062f \u0645\u0646 Lab API \u0627\u0644\u062e\u0627\u0631\u062c\u064a"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "running",
        "stopped",
        "error",
        "expired",
        "completed"
      ],
      "default": "preparing"
    },
    "desktop_url": {
      "type": "string"
    },
    "target_ip": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "stopped_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "lab_id",
    "session_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}